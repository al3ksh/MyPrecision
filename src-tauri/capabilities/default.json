{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the flyout and full window",
  "windows": [
    "flyout",
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:event:default",
    "updater:default",
    "process:allow-restart"
  ]
}
